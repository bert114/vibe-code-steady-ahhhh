# Dev-only image for Steady-Ahh client (Vite, port 5173).
# Built from repo root so `npm ci` can use the single root lockfile.
# VITE_* values come from runtime client/.env via compose env_file, not baked in.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY client/package.json ./client/package.json
COPY server/package.json ./server/package.json
RUN npm ci --workspace=client --no-audit --no-fund

COPY client/ ./client/

EXPOSE 5173

CMD ["npm", "run", "dev", "--workspace=client", "--", "--host", "--port", "5173"]
