# Steady-Ahh environment template — NAMES ONLY, never real secrets.
# Copy to server/.env and client/.env for local dev; real .env files stay out of Git.

# ---- Server (server/.env) ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'
DEV_AUTH_BYPASS=true
DEV_USER_ID=
# TEMP-OPEN-ACCESS (revert before beta): unset/true = every req allowed, no
# auth, attributed to DEV_USER_ID. Set OPEN_ACCESS=false to restore 401s.
# Refuses to boot when NODE_ENV=production.
OPEN_ACCESS=true
# Per-request safe audit to console JSON. Set AUDIT_ENABLED=false to silence.
AUDIT_ENABLED=true
AI_PROVIDER=groq
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Groq free key (no card): console.groq.com → API Keys → Create API Key.
# Shape: gsk_ + a long random string, e.g. GROQ_API_KEY=gsk_paste_yours_here
# Never commit a real key — names and placeholders only in this file.
GROQ_API_KEY=
# Pinned model id; empty takes the code default (openai/gpt-oss-120b).
GROQ_MODEL=
AI_ANALYSIS_RATE_LIMIT=5
AI_MAX_INPUT_CHARS=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Client (single client/.env; no per-mode files) ----
# Local dev: VITE_API_URL=http://localhost:5000/api
# Production (Render Static Site dashboard, baked at build, needs redeploy):
# VITE_API_URL=https://vibe-code-steady-ahhhh.onrender.com/api
VITE_API_URL=http://localhost:5000/api
VITE_DEV_AUTH_BYPASS=true
VITE_CLERK_PUBLISHABLE_KEY=
VITE_FEEDBACK_URL=
