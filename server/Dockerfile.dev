# Dev-only image for Steady-Ahh API (Express, port 5000).
# Built from repo root so `npm ci` can use the single root lockfile.
# Secrets are NEVER baked in (.dockerignore excludes .env); compose injects via env_file.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY client/package.json ./client/package.json
COPY server/package.json ./server/package.json
RUN npm ci --workspace=server --no-audit --no-fund

COPY server/ ./server/

EXPOSE 5000

CMD ["npm", "run", "dev", "--workspace=server"]
